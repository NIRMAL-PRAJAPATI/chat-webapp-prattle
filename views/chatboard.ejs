<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content">
    <title>Chat with <%= user2 %> | Prattle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Shared Prattle surface: matches the conversation-list background. */
        .whatsapp-bg {
            background-color: #111827;
            background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* BUG FIX: html/body must not scroll — only #chatBox should. A scrollable body is what let
           mobile browsers "helpfully" scroll the whole page up when the keyboard opened, shoving the
           header and messages off the top of the screen. */
        html, body {
            height: 100%;
            overflow: hidden;
            margin: 0;
        }

        /* BUG FIX: 100vh (Tailwind's h-screen) is measured once and does not shrink when the mobile
           keyboard opens — most noticeable on iOS Safari — so the shell kept claiming the full
           device height and the input bar (previously forced to position:fixed on mobile) ended up
           floating over the header/messages instead of sitting above the keyboard. 100dvh tracks the
           real visible viewport; the visualViewport JS below covers browsers that need extra help
           keeping everything in view while the keyboard is open.  */
        .chat-shell {
            height: 100vh;
            height: 100dvh;
        }

        /* Custom scrollbar for emoji picker and chat */
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(134, 150, 160, 0.3);
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(134, 150, 160, 0.5);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Message Bubble Tail */
        .message-sent {
            background-color: #005c4b;
            border-radius: 12px 12px 2px 12px;
        }

        .message-received {
            background-color: #1f2937;
            border-radius: 12px 12px 12px 2px;
        }

        /* WhatsApp Input Transition */
        #inputMessage {
            transition: height 0.08s ease-out;
        }
    </style>
</head>

<body class="bg-gray-900">
    <!-- sent Message sound -->
    <audio id="recieveMessageAudio">
        <source src="/img/recieveMessage.mp3" type="audio/mp3">
    </audio>

    <div id="chatShell" class="chat-shell grid grid-rows-[auto,1fr,auto] bg-gray-900 text-white">
        <!-- WhatsApp Header Bar -->
        <div
            class="flex px-3 py-2.5 mx-0 text-white bg-gray-900 border-b border-gray-700 justify-between items-center z-10 shadow-sm">
            <div class="flex items-center gap-3">
                <% if(user2=="Prattle AI" ) { %>
                    <div class="relative">
                        <img src="/img/logo 1.png" alt="Prattle AI"
                            class="w-10 h-10 p-1 bg-gray-800 rounded-full border border-gray-700">
                        <span
                            class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-gray-900"></span>
                    </div>
                    <% } else { %>
                        <div class="relative">
                            <img src="/img/profile.png" alt="<%= user2 %>"
                                class="w-10 h-10 rounded-full border border-gray-600 object-cover">
                            <span id="userStatusDot"
                                class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-gray-500 rounded-full border-2 border-gray-900"></span>
                        </div>
                        <% } %>
                            <div>
                                <h2 id="takerusername"
                                    class="text-base sm:text-lg font-semibold tracking-wide text-gray-100">
                                    <%= user2 %>
                                </h2>
                                <div id="userStatusDiv">
                                    <p class="text-xs text-gray-400">
                                        <% if(user2=="Prattle AI" ) { %>
                                            <span class="text-emerald-400">AI Assistant</span>
                                            <% } else { %>
                                                Offline
                                                <% } %>
                                    </p>
                                </div>
                            </div>
            </div>
            <div class="flex pt-1 px-1 gap-4 items-center">
                <i id="eraseChat"
                    class="fa-solid fa-eraser text-gray-400 hover:text-white text-lg cursor-pointer transition-colors"
                    title="Erase Chat"></i>
                <i
                    class="fa-solid fa-user-slash text-gray-400 hover:text-white text-lg cursor-pointer transition-colors"></i>
                <i id="userDetailsBtn"
                    class="fa-solid fa-circle-info text-gray-400 hover:text-white text-lg cursor-pointer transition-colors"></i>
                <div id="userDetailsCont"
                    class="absolute py-2 px-3 bg-gray-900 rounded-lg text-gray-300 w-[290px] right-0 m-2 mt-8 text-[12px] tracking-wider hidden z-50 shadow-2xl border border-gray-700">
                    <p class="mb-1 text-gray-400">Prattle User ID: <span class="text-xs text-emerald-400 font-bold">
                            PR<%= userDetails.id %>TL2<%= userDetails.id %>
                        </span></p>
                    <p class="mb-1 text-gray-400">Joined: <span class="text-xs text-emerald-400 font-medium"
                            id="joiningDate">
                            <%= userDetails.joining_date %>
                        </span></p>
                    <p class="mb-1 text-gray-400">
                        <%= userDetails.username %> has <span class="text-xs text-emerald-400 font-bold">
                                <%= userDetails.followed_user ? Math.max(userDetails.followed_user.length - 1, 0) : 0 %>
                            </span> friends
                    </p>
                </div>
            </div>
        </div>

        <!-- Chat Messages Area (WhatsApp wallpaper) -->
        <div id="chatBox" class="overflow-y-auto p-3 sm:p-4 space-y-2 custom-scrollbar whatsapp-bg">
            <!-- Messages rendered here -->
        </div>

        <!-- WhatsApp Bottom Input Section -->
        <div class="bg-gray-900 p-2 sm:p-2.5 relative border-t border-gray-700">
            <!-- Emoji Picker Container Popover -->
            <div id="emojiPickerContainer"
                class="hidden opacity-0 scale-95 pointer-events-none absolute bottom-16 left-2 sm:left-4 z-50 bg-gray-900/98 backdrop-blur-xl border border-gray-700 shadow-2xl rounded-2xl w-[94vw] sm:w-[360px] max-h-[400px] flex flex-col transition-all duration-150 ease-out">
            </div>

            <p id="thinkLoading"
                class="hidden my-1.5 font-medium text-emerald-400 text-xs tracking-wide animate-pulse delay-50 items-center">
                PrattleAI is Typing
                <span class="ml-2 flex space-x-1">
                    <span class="h-1.5 w-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span class="h-1.5 w-1.5 bg-emerald-500 rounded-full animate-pulse delay-150"></span>
                    <span class="h-1.5 w-1.5 bg-emerald-500 rounded-full animate-pulse delay-300"></span>
                </span>
            </p>

            <!-- WhatsApp Input Form with onsubmit preventDefault -->
            <form id="sendChatInput" onsubmit="return false;" class="flex items-end gap-2 relative w-full">
                <!-- WhatsApp Input Pill Capsule -->
                <div id="inputPill"
                    class="flex-1 bg-gray-800 rounded-[24px] sm:rounded-[26px] px-2.5 sm:px-3 py-1 flex items-end gap-1.5 sm:gap-2 shadow-sm min-h-[44px] transition-all duration-100 focus-within:ring-1 focus-within:ring-gray-600/40">
                    <!-- Left Emoji Button inside Pill -->
                    <button type="button" id="emojiToggleBtn"
                        class="h-[34px] w-[34px] rounded-full hover:bg-gray-700/60 flex items-center justify-center text-gray-400 hover:text-gray-200 transition-colors flex-shrink-0 mb-0.5 focus:outline-none active:scale-95"
                        title="Emoji">
                        <i class="fa-regular fa-face-smile text-xl mt-1"></i>
                    </button>

                    <!-- Textarea in Pill (WhatsApp auto-expanding movement) -->
                    <textarea id="inputMessage" placeholder="Type a message" rows="1"
                        class="flex-1 bg-transparent text-gray-100 placeholder:text-gray-400 text-[15px] sm:text-[16px] outline-none resize-none border-0 p-0 py-2 leading-[20px] max-h-[130px] min-h-[25px] custom-scrollbar"></textarea>
                </div>

                <!-- Dedicated WhatsApp Circular Floating Send Button -->
                <button type="button" id="sendChatBtn"
                    class="h-[44px] w-[44px] sm:h-[46px] sm:w-[46px] rounded-full bg-[#00a884] hover:bg-[#02906f] active:scale-90 text-white flex items-center justify-center shadow-lg transition-all duration-150 flex-shrink-0 cursor-pointer mb-0.5 focus:outline-none"
                    title="Send">
                    <i class="fa-solid fa-paper-plane text-lg text-white transition-transform duration-150"></i>
                </button>
            </form>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/emoji_picker.js"></script>

    <script>
        (function () {
            'use strict';

            // Use existing socket or initialize new one
            const chatSocket = (typeof window.socket !== 'undefined') ? window.socket : io();
            const currentRoomId = "<%= roomId %>";
            const user1 = "<%= user1 %>";
            const user2 = "<%= user2 %>";

            // Initialize Emoji Picker
            let prattleEmoji = null;
            if (window.PrattleEmojiPicker) {
                prattleEmoji = new window.PrattleEmojiPicker({
                    containerId: 'emojiPickerContainer',
                    toggleBtnId: 'emojiToggleBtn',
                    inputId: 'inputMessage'
                });
            }

            const inputMessageEl = document.querySelector('#inputMessage');
            const sendChatBtn = document.querySelector('#sendChatBtn');
            const sendChatInput = document.querySelector('#sendChatInput');
            const chatBox = document.querySelector('#chatBox');
            const chatShell = document.getElementById('chatShell');

            // BUG FIX (mobile keyboard floats header/messages off-screen): keep the shell locked to
            // the real visible viewport (shrinks when the keyboard opens) and keep the page pinned at
            // the top instead of letting the browser scroll it to "reveal" the focused input.
            function syncViewportHeight() {
                if (!chatShell) return;
                const visibleHeight = window.visualViewport ? window.visualViewport.height : window.innerHeight;
                chatShell.style.height = visibleHeight + 'px';
                window.scrollTo(0, 0);
                if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
            }

            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', syncViewportHeight);
                window.visualViewport.addEventListener('scroll', syncViewportHeight);
            }
            window.addEventListener('orientationchange', () => setTimeout(syncViewportHeight, 250));
            syncViewportHeight();

            // WhatsApp-style dynamic textarea expansion
            function updateWhatsAppInput() {
                if (!inputMessageEl) return;
                inputMessageEl.style.height = 'auto';
                const newHeight = Math.min(inputMessageEl.scrollHeight, 130);
                inputMessageEl.style.height = newHeight + 'px';
                inputMessageEl.style.overflowY = inputMessageEl.scrollHeight > 130 ? 'auto' : 'hidden';
            }

            // Helper to escape HTML for safety while preserving emojis
            function escapeHtmlMsg(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // Helper to format time (e.g. 10:24 PM)
            function getCurrentTime() {
                return new Date().toLocaleTimeString("en-US", {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true,
                });
            }

            // Primary send function called by both Enter key and Send button click
            async function handleSendMessage() {
                if (!inputMessageEl) return;
                const message = inputMessageEl.value.trim();
                if (message.length === 0) return;

                if (prattleEmoji && prattleEmoji.isOpen) {
                    prattleEmoji.close();
                }

                if (currentRoomId !== "Prattle AI") {
                    await chatSocket.emit("privateMessage", { roomId: currentRoomId, sender: user1, message });

                    if (chatBox) {
                        chatBox.innerHTML += `
                            <div class="flex justify-end">
                                <div class="message-sent text-white py-1.5 px-3 max-w-[85%] lg:max-w-[65%] shadow-sm">
                                    <p class="text-[15px] sm:text-base break-words whitespace-pre-wrap leading-relaxed">${escapeHtmlMsg(message)}</p>
                                    <div class="flex items-center justify-end gap-1 -mt-0.5 -mb-0.5">
                                        <span class="text-[10px] text-gray-300/80">${getCurrentTime()}</span>
                                    </div>
                                </div>
                            </div>`;
                        chatBox.scrollTop = chatBox.scrollHeight;
                    }
                } else {
                    const think = document.querySelector('#thinkLoading');
                    if (think) {
                        think.style.display = "flex";
                        think.classList.remove("hidden");
                    }

                    chatSocket.emit("chatbot_request", message);

                    if (chatBox) {
                        chatBox.innerHTML += `
                            <div class="flex justify-end">
                                <div class="message-sent text-white py-1.5 px-3 max-w-[85%] lg:max-w-[65%] shadow-sm">
                                    <p class="text-[15px] sm:text-base break-words whitespace-pre-wrap leading-relaxed">${escapeHtmlMsg(message)}</p>
                                    <div class="flex items-center justify-end gap-1 -mt-0.5 -mb-0.5">
                                        <span class="text-[10px] text-gray-300/80">${getCurrentTime()}</span>
                                    </div>
                                </div>
                            </div>`;
                        chatBox.scrollTop = chatBox.scrollHeight;
                    }
                }

                inputMessageEl.value = "";
                inputMessageEl.style.height = 'auto';
                updateWhatsAppInput();
                inputMessageEl.focus();
            }

            if (inputMessageEl) {
                inputMessageEl.addEventListener('input', updateWhatsAppInput);

                // BUG FIX: re-measure right after the keyboard starts opening/closing on focus/blur —
                // visualViewport's own resize event can lag on some Android/iOS versions.
                inputMessageEl.addEventListener('focus', () => setTimeout(syncViewportHeight, 300));
                inputMessageEl.addEventListener('blur', () => setTimeout(syncViewportHeight, 300));

                // Handle Enter key for sending messages (Shift+Enter for newline)
                inputMessageEl.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        e.stopPropagation();
                        handleSendMessage();
                        return false;
                    }
                });
            }

            if (sendChatBtn) {
                sendChatBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    handleSendMessage();
                });
            }

            if (sendChatInput) {
                sendChatInput.addEventListener('submit', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    handleSendMessage();
                    return false;
                });
            }

            // Format joining date
            function formatJoiningDate(dateString) {
                if (!dateString) return 'Recent';
                const date = new Date(dateString);
                if (isNaN(date.getTime())) return dateString;
                const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const weekday = weekdays[date.getUTCDay()];
                const day = String(date.getUTCDate()).padStart(2, '0');
                const month = String(date.getUTCMonth() + 1).padStart(2, '0');
                const year = date.getUTCFullYear();
                return `${weekday}, ${day}/${month}/${year}`;
            }

            const joiningDateEl = document.getElementById('joiningDate');
            if (joiningDateEl) {
                joiningDateEl.textContent = formatJoiningDate('<%= userDetails.joining_date %>');
            }

            const userDetailsBtn = document.querySelector('#userDetailsBtn');
            const userDetailsCont = document.querySelector('#userDetailsCont');

            if (userDetailsBtn && userDetailsCont) {
                // Desktop: preview on hover
                userDetailsBtn.addEventListener('mouseover', () => {
                    userDetailsCont.style.display = 'block';
                });
                userDetailsBtn.addEventListener('mouseout', () => {
                    userDetailsCont.style.display = 'none';
                });

                // BUG FIX: mouseover/mouseout never fire reliably on touch devices, so this info
                // panel was effectively impossible to open on mobile. Make it tap-toggleable too,
                // and dismiss it when tapping anywhere else.
                userDetailsBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = userDetailsCont.style.display === 'block';
                    userDetailsCont.style.display = isOpen ? 'none' : 'block';
                });

                document.addEventListener('click', (e) => {
                    if (!userDetailsCont.contains(e.target) && e.target !== userDetailsBtn) {
                        userDetailsCont.style.display = 'none';
                    }
                });
            }

            document.querySelector('#eraseChat')?.addEventListener('click', () => {
                if (chatBox) chatBox.innerHTML = "";
            });

            // Handle user status update
            chatSocket.off("userStatus");
            chatSocket.on("userStatus", (data) => {
                const { username, status } = data;

                // Only update status if it's for the current chat user (case-insensitive)
                if (username && username.toLowerCase() === user2.toLowerCase() && user2 !== "Prattle AI") {
                    const statusDiv = document.querySelector('#userStatusDiv');
                    const statusDot = document.querySelector('#userStatusDot');
                    if (statusDiv) {
                        if (status === "online") {
                            statusDiv.innerHTML = `<p class="text-xs text-emerald-400 font-medium">online</p>`;
                            if (statusDot) statusDot.className = "absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-gray-900";
                        } else {
                            statusDiv.innerHTML = `<p class="text-xs text-gray-400">offline</p>`;
                            if (statusDot) statusDot.className = "absolute bottom-0 right-0 w-2.5 h-2.5 bg-gray-500 rounded-full border-2 border-gray-900";
                        }
                    }
                }
            });

            // Request status for current user
            if (user2 !== "Prattle AI") {
                chatSocket.emit("getUserStatus", user2);
            }

            // Emit start private chat event
            chatSocket.emit("startPrivateChat", { user1: user1, user2: user2 });

            if (currentRoomId !== "Prattle AI") {
                // Receive private message
                chatSocket.off("privateMessage");
                chatSocket.on("privateMessage", ({ sender, message }) => {
                    if (message && message.length > 0) {
                        if (chatBox) {
                            chatBox.innerHTML += `
                                <div class="flex justify-start">
                                    <div class="message-received text-white py-1.5 px-3 max-w-[85%] lg:max-w-[65%] shadow-sm">
                                        <span class="flex justify-start text-[#53bdeb] text-[12px] font-semibold -mb-0.5">${escapeHtmlMsg(sender)}</span>
                                        <p class="text-[15px] sm:text-base break-words whitespace-pre-wrap leading-relaxed">${escapeHtmlMsg(message)}</p>
                                        <div class="flex items-center justify-end -mt-0.5 -mb-0.5">
                                            <span class="text-[10px] text-gray-400">${getCurrentTime()}</span>
                                        </div>
                                    </div>
                                </div>`;
                            chatBox.scrollTop = chatBox.scrollHeight;
                        }

                        const audio = document.querySelector('#recieveMessageAudio');
                        if (audio) {
                            audio.currentTime = 0;
                            audio.play().catch(() => { });
                        }
                    }
                });

            } else {
                // Receive chatbot message
                chatSocket.off("chatbot_response");
                chatSocket.on("chatbot_response", (message) => {
                    if (message && message.length > 0) {
                        if (chatBox) {
                            chatBox.innerHTML += `
                                <div class="flex justify-start">
                                    <div class="message-received text-white py-1.5 px-3 max-w-[85%] lg:max-w-[65%] shadow-sm">
                                        <span class="flex justify-start text-[#53bdeb] text-[12px] font-semibold -mb-0.5">Prattle AI</span>
                                        <p class="whitespace-pre-wrap break-words leading-relaxed text-[15px] sm:text-base">${escapeHtmlMsg(message)}</p>
                                        <div class="flex items-center justify-end -mt-0.5 -mb-0.5">
                                            <span class="text-[10px] text-gray-400">${getCurrentTime()}</span>
                                        </div>
                                    </div>
                                </div>`;
                            chatBox.scrollTop = chatBox.scrollHeight;
                        }

                        const audio = document.querySelector('#recieveMessageAudio');
                        if (audio) {
                            audio.currentTime = 0;
                            audio.play().catch(() => { });
                        }

                        const think = document.querySelector('#thinkLoading');
                        if (think) {
                            think.style.display = "none";
                            think.classList.add("hidden");
                        }
                    }
                });
            }
        })();
    </script>
</body>

</html>
