<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Prattle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Shared Prattle surface: matches the main-board conversation list. */
        body {
            background: #111827;
            min-height: 100vh;
        }
        /* Glassmorphism card */
        .glass-card {
            background: #111827;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid #374151;
        }
        /* Confirmation overlay */
        .confirm-overlay {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
        }
        /* Input focus glow */
        .input-glow:focus {
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
        }
        /* Button pulse on hover */
        .btn-primary {
            background: #15803d;
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            background: #16a34a;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(22, 163, 74, 0.25);
        }
        /* Logo glow */
        .logo-text {
            background: linear-gradient(135deg, #34d399, #10b981);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        /* Fade-in animation */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        .animate-fade-in-delay {
            animation: fadeInUp 0.5s ease-out 0.15s forwards;
            opacity: 0;
        }
    </style>
</head>
<body class="flex items-center justify-center p-4 sm:p-6">
    <!-- Registration confirmation modal -->
    <div id="confirmationbox" class="items-center <%= showdiv %> justify-center fixed inset-0 z-50 confirm-overlay" style="display: <%= showdiv %>;">
        <div class="glass-card p-8 rounded-2xl w-[90%] sm:w-[450px] mx-auto text-center animate-fade-in">
            <div class="w-14 h-14 bg-emerald-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
            </div>
            <h2 class="font-bold text-2xl text-white mb-2">Create Account?</h2>
            <p class="text-gray-400 text-sm mb-6 leading-relaxed">This username doesn't exist yet. Would you like to create an account with these credentials?</p>
            <form action="submit/create" method="POST">
                <div class="flex gap-3">
                    <button type="submit" class="flex-1 py-2.5 px-4 text-sm font-semibold rounded-xl text-white btn-primary">Yes, Create Account</button>
                    <button type="button" id="cancelconfirmationbtn" class="flex-1 py-2.5 px-4 text-sm font-semibold rounded-xl text-gray-300 border border-gray-600 hover:border-gray-400 hover:text-white transition-all">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Main layout -->
    <div class="flex flex-col lg:flex-row items-center justify-center w-full max-w-5xl mx-auto gap-8 lg:gap-16 min-h-screen">
        <!-- Logo (top on mobile, left on desktop) -->
        <div class="absolute top-4 left-4 flex items-center gap-1.5">
            <img src="/img/logo 1.png" class="h-4 sm:h-5">
            <span class="logo-text text-lg sm:text-xl font-semibold tracking-wide">Prattle</span>
        </div>

        <!-- Left side hero text (hidden on mobile) -->
        <div class="hidden lg:block max-w-md animate-fade-in">
            <h1 class="text-white text-4xl xl:text-5xl font-bold tracking-wide leading-tight">
                Communicate with others
                <span class="inline-block mt-1 px-2 py-0.5 rounded bg-green-700/80">anonymously</span>
            </h1>
            <p class="text-gray-400 mt-5 text-sm leading-relaxed">Prattle is a secure platform that allows users to chat anonymously without compromising their privacy or sharing any personal information. It fosters open and private communication, ensuring users can connect freely and safely with others.</p>
        </div>

        <!-- Login card -->
        <div class="glass-card w-full max-w-md rounded-2xl p-6 sm:p-8 animate-fade-in-delay">
            <div class="text-center mb-6">
                <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Welcome Back</h2>
                <p class="text-gray-400 text-sm mt-1">Login or create your account</p>
            </div>

            <form id="formsubmit" action="submit" method="POST" class="space-y-4">
                <p id="errormsg" class="text-red-400 text-sm min-h-[20px]"><%= loginerrmsg %></p>

                <div>
                    <label for="username" class="block text-xs font-medium text-gray-400 mb-1.5 uppercase tracking-wider">Username</label>
                    <input id="username" name="username" type="text" required
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-xl text-white text-sm tracking-wide placeholder-gray-500 outline-none input-glow focus:border-emerald-500/50 transition-all lowercase"
                        placeholder="Enter your username" value="<%= username %>">
                </div>

                <div>
                    <label for="password" class="block text-xs font-medium text-gray-400 mb-1.5 uppercase tracking-wider">Password</label>
                    <input id="password" name="password" type="password" required
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-xl text-white text-sm tracking-wide placeholder-gray-500 outline-none input-glow focus:border-emerald-500/50 transition-all"
                        placeholder="Enter your password" value="<%= password %>">
                </div>

                <div>
                    <label for="conpassword" class="block text-xs font-medium text-gray-400 mb-1.5 uppercase tracking-wider">Confirm Password</label>
                    <!-- BUG FIX: Was pre-filling confirm password with the actual password value — security risk & confusing UX -->
                    <input id="conpassword" name="conpassword" type="password" required
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-xl text-white text-sm tracking-wide placeholder-gray-500 outline-none input-glow focus:border-emerald-500/50 transition-all"
                        placeholder="Confirm your password">
                </div>

                <button id="formbtn" type="submit"
                    class="w-full py-3 px-4 text-sm font-semibold rounded-xl text-white btn-primary tracking-wider mt-2">
                    Chat Now
                </button>
            </form>

            <p class="mt-5 text-gray-500 text-xs leading-relaxed text-center">
                Enter your username and password to login. If the username doesn't exist, Prattle will create a new account for you.
            </p>
        </div>
    </div>

    <script src="/js/form.js"></script>
</body>
</html>
